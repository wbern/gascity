sh -c 'case "$GC_SESSION_ORIGIN" in ephemeral|"") ;; *) [ -n "$GC_ALIAS" ] && [ "$1" = "$GC_ALIAS" ] || exit 0 ;; esac; probe_pool_demand() { target="$1"; [ -z "$target" ] && return 1; if [ "$GC_SESSION_ORIGIN" != "named" ]; then r=$(gc ready --metadata-field "gc.routed_to=$target" --unassigned --exclude-type=epic --exclude-label "hold:mayor" --exclude-label "hold:external" --exclude-label "held" --exclude-label "hold:human" --exclude-label "human" --json --limit=20) || exit $?; else r=$(gc ready --metadata-field "gc.routed_to=$target" --metadata-field "gc.formula_contract=graph.v2" --unassigned --exclude-type=epic --exclude-label "hold:mayor" --exclude-label "hold:external" --exclude-label "held" --exclude-label "hold:human" --exclude-label "human" --json --limit=20) || exit $?; if [ -z "$r" ] || [ "$r" = "[]" ]; then gc_named_legacy_routed=$(gc ready --metadata-field "gc.routed_to=$target" --unassigned --exclude-type=epic --exclude-label "hold:mayor" --exclude-label "hold:external" --exclude-label "held" --exclude-label "hold:human" --exclude-label "human" --json --limit=0) || exit $?; r=$(printf "%s" "$gc_named_legacy_routed" | jq -c '\''.[] | select(((.metadata["gc.root_bead_id"] // "") != "") and ((.metadata["gc.step_ref"] // "") != ""))'\'' 2>/dev/null | while IFS= read -r candidate; do root=$(printf "%s" "$candidate" | jq -r '\''(.metadata["gc.root_bead_id"] // "")'\'' 2>/dev/null); [ -n "$root" ] || continue; [ "$(bd show --json "$root" 2>/dev/null | jq -r '\''.[0].metadata["gc.formula_contract"] // ""'\'' 2>/dev/null)" = "graph.v2" ] || continue; printf '\''[%s]'\'' "$candidate"; break; done); fi; fi; gc_preferred_pool_demand=$(printf "%s" "$r" | jq -c '\''[.[] | select((((.metadata["gc.kind"] // "") == "workflow") and ((.metadata["gc.formula_contract"] // "") == "graph.v2")) | not)] + [.[] | select(((.metadata["gc.kind"] // "") == "workflow") and ((.metadata["gc.formula_contract"] // "") == "graph.v2"))]'\'' 2>/dev/null); [ -n "$gc_preferred_pool_demand" ] && r="$gc_preferred_pool_demand"; [ -n "$r" ] && [ "$r" != "[]" ] && printf "%s" "$r" && exit 0; [ "$GC_SESSION_ORIGIN" = "named" ] && return 1; legacy_candidates=$(gc ready --metadata-field "gc.run_target=$target" --metadata-field "gc.kind=workflow" --unassigned --exclude-type=epic --exclude-label "hold:mayor" --exclude-label "hold:external" --exclude-label "held" --exclude-label "hold:human" --exclude-label "human" --json --sort oldest --limit=20) || exit $?; r=$(printf "%s" "$legacy_candidates" | jq '\''[.[] | select(((.metadata["gc.routed_to"] // "") == "") and ((.metadata["gc.workflow_expanded"] // "") != "true"))] | .[:1]'\'' 2>/dev/null); [ -n "$r" ] && [ "$r" != "[]" ] && printf "%s" "$r" && exit 0; [ -n "${open_ephemeral_set:-}" ] || { open_ephemeral=$(bd query --json '\''ephemeral=true AND status=open'\'' --limit=0 2>/dev/null); open_ephemeral_set=1; }; legacy_ephemeral_candidates=$({ printf "%s" "$open_ephemeral" | jq --arg target "$target" '\''[.[] | select((.assignee // "") == "") | select(((.metadata["gc.routed_to"] // "") == $target) or (((.metadata["gc.routed_to"] // "") == "") and ((.metadata["gc.run_target"] // "") == $target) and ((.metadata["gc.kind"] // "") == "workflow") and ((.metadata["gc.workflow_expanded"] // "") != "true"))) | select(((.issue_type // .type // "") != "epic")) | select(([ (.labels // [])[] | select(. == "hold:mayor" or . == "hold:external" or . == "held" or . == "hold:human" or . == "human") ] | length) == 0) | select(((.dependency_count // 0) == 0))] | sort_by(.created_at // "", .id // "") | .[:20]'\'' 2>/dev/null; } || printf "[]"); r=$(printf "%s" "$legacy_ephemeral_candidates" | jq '\''.[0:1]'\'' 2>/dev/null); [ -n "$r" ] && [ "$r" != "[]" ] && printf "%s" "$r" && exit 0; return 1; }; probe_pool_demand "$1"; probe_pool_demand "$2"; printf "[]"' -- rig/control-dispatcher rig/workflow-control