sh -c 'for id in "$GC_SESSION_ID" "$GC_SESSION_NAME" "$GC_ALIAS"; do [ -z "$id" ] && continue; legacy=""; case "$id" in *control-dispatcher) legacy="${id%control-dispatcher}workflow-control";; esac; for cand in "$id" "$legacy"; do [ -z "$cand" ] && continue; r=$(gc ready --status in_progress --assignee="$cand" --json --brief --exclude-label='\''hold:mayor'\'' --exclude-label='\''hold:external'\'' --exclude-label='\''held'\'' --exclude-label='\''hold:human'\'' --limit=1) || exit $?; if [ -n "$r" ] && [ "$r" != "[]" ]; then nheld=$(printf "%s" "$r" | jq -r '\''[ (.[0].labels // [])[] | select(. == "hold:mayor" or . == "hold:external" or . == "held" or . == "hold:human") ] | length'\'' 2>/dev/null); [ -z "$nheld" ] && nheld=0; if [ "$nheld" = "0" ]; then bid=$(printf "%s" "$r" | jq -r ".[0].id // empty" 2>/dev/null); if [ -z "$bid" ]; then printf "%s" "$r" && exit 0; else bb=$(printf "%s" "$r" | jq -c '\''.[0].blocked_by // empty'\'' 2>/dev/null); if [ -z "$bb" ]; then detail=$(bd show "$bid" --json --brief-deps) || exit $?; bb=$(printf "%s" "$detail" | jq -ce '\''if type != "array" or length != 1 or (.[0] | type) != "object" or (.[0].id | type) != "string" or ((.[0].dependencies // []) | type) != "array" then error("invalid issue detail") else [.[0].dependencies[]? | if type != "object" or (.dependency_type | type) != "string" then error("invalid dependency evidence") else select(.dependency_type == "blocks" or .dependency_type == "waits-for" or .dependency_type == "conditional-blocks") | if (.id | type) != "string" or (.status | type) != "string" then error("incomplete blocker evidence") else {id, status} end end] end'\'') || { printf "%s\n" "work discovery: dependency evidence unavailable for $bid" >&2; exit 1; }; fi; nblocked=$(printf "%s" "$bb" | jq -er '\''if type != "array" then error("invalid blocker evidence") else [.[] | if type != "object" or (.id | type) != "string" or (.status | type) != "string" then error("incomplete blocker evidence") else select((.status | ascii_downcase) != "closed") end] | length end'\'') || exit $?; if [ "$nblocked" = "0" ]; then r_enriched=$(printf "%s" "$r" | jq -c --argjson bb "$bb" '\''map(. + {blocked_by: $bb})'\'') || exit $?; r="$r_enriched"; printf "%s" "$r" && exit 0; fi; fi; fi; fi; [ -n "${in_progress_ephemeral_set:-}" ] || { in_progress_ephemeral=$(bd query --json '\''ephemeral=true AND status=in_progress'\'' --limit=0 2>/dev/null); in_progress_ephemeral_set=1; }; r=$(printf "%s" "$in_progress_ephemeral" | jq --arg id "$cand" '\''[.[] | select((.assignee // "") == $id) | select(([ (.labels // [])[] | select(. == "hold:mayor" or . == "hold:external" or . == "held" or . == "hold:human") ] | length) == 0)] | .[:1]'\'' 2>/dev/null); if [ -n "$r" ] && [ "$r" != "[]" ]; then bid=$(printf "%s" "$r" | jq -r ".[0].id // empty" 2>/dev/null); if [ -z "$bid" ]; then printf "%s" "$r" && exit 0; else bb=$(printf "%s" "$r" | jq -c '\''if .[0].dependency_count == 0 then [] else empty end'\'' 2>/dev/null); if [ -z "$bb" ]; then detail=$(bd show "$bid" --json --brief-deps) || exit $?; bb=$(printf "%s" "$detail" | jq -ce '\''if type != "array" or length != 1 or (.[0] | type) != "object" or (.[0].id | type) != "string" or ((.[0].dependencies // []) | type) != "array" then error("invalid issue detail") else [.[0].dependencies[]? | if type != "object" or (.dependency_type | type) != "string" then error("invalid dependency evidence") else select(.dependency_type == "blocks" or .dependency_type == "waits-for" or .dependency_type == "conditional-blocks") | if (.id | type) != "string" or (.status | type) != "string" then error("incomplete blocker evidence") else {id, status} end end] end'\'') || { printf "%s\n" "work discovery: dependency evidence unavailable for $bid" >&2; exit 1; }; fi; nblocked=$(printf "%s" "$bb" | jq -er '\''if type != "array" then error("invalid blocker evidence") else [.[] | if type != "object" or (.id | type) != "string" or (.status | type) != "string" then error("incomplete blocker evidence") else select((.status | ascii_downcase) != "closed") end] | length end'\'') || exit $?; if [ "$nblocked" = "0" ]; then r_enriched=$(printf "%s" "$r" | jq -c --argjson bb "$bb" '\''map(. + {blocked_by: $bb})'\'') || exit $?; r="$r_enriched"; printf "%s" "$r" && exit 0; fi; fi; fi; done; done; printf "[]"'