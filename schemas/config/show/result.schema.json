{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "ok",
    "city_path",
    "config",
    "warnings",
    "validation",
    "resolved_agents"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "ok": {
      "const": true
    },
    "city_path": {
      "type": "string"
    },
    "config": {
      "type": "object",
      "additionalProperties": true
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation": {
      "type": "object",
      "required": [
        "ok",
        "warnings",
        "errors"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "provenance": {
      "additionalProperties": true
    },
    "resolved_agents": {
      "type": "array",
      "description": "Canonical agent identity paired with resolved policy from the same config load as config, including config.Workspace.CapacityGroups. Runtime-only binding fields remain absent from agent.",
      "items": {
        "type": "object",
        "required": [
          "qualified_name",
          "agent",
          "suspended"
        ],
        "properties": {
          "qualified_name": {
            "type": "string",
            "minLength": 1
          },
          "agent": {
            "type": "object",
            "additionalProperties": true
          },
          "suspended": {
            "type": "boolean",
            "description": "Effective suspension including the runtime city/rig state, read once for this response."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
