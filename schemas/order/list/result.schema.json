{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "ok",
    "orders",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "ok": {
      "const": true
    },
    "city_path": {
      "type": "string"
    },
    "city_name": {
      "type": "string"
    },
    "orders": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/order"
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "count",
        "enabled",
        "disabled",
        "total",
        "filter"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0,
          "description": "Orders emitted in this payload, after the filter named by `filter`."
        },
        "enabled": {
          "type": "integer",
          "minimum": 0,
          "description": "Enabled orders in the scanned set, independent of the filter."
        },
        "disabled": {
          "type": "integer",
          "minimum": 0,
          "description": "Disabled orders in the scanned set. Non-zero with filter=\"enabled\" means rows were withheld; pass --all to include them."
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "description": "Orders in the scanned set before filtering (enabled + disabled)."
        },
        "filter": {
          "type": "string",
          "enum": [
            "enabled",
            "all"
          ],
          "description": "The view that produced `orders`. \"enabled\" withholds disabled orders; \"all\" includes them. Read this before treating the payload as a complete inventory."
        }
      },
      "additionalProperties": true
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "order": {
      "type": "object",
      "required": [
        "name",
        "scoped_name",
        "type",
        "trigger",
        "enabled"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "scoped_name": {
          "type": "string"
        },
        "rig": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "formula",
            "exec"
          ]
        },
        "formula": {
          "type": "string"
        },
        "exec": {
          "type": "string"
        },
        "trigger": {
          "type": "string"
        },
        "interval": {
          "type": "string"
        },
        "schedule": {
          "type": "string"
        },
        "check": {
          "type": "string"
        },
        "on": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "timeout": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "source": {
          "type": "string"
        },
        "formula_layer": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
