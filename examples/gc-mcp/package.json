{
  "name": "gc-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only (phase 1) MCP server exposing Gas City to voice assistants",
  "scripts": {
    "gen:types": "openapi-typescript ../../internal/api/openapi.json -o src/api-types.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --no-file-parallelism",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
